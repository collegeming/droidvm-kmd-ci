+        D3DKMDT_STANDARDALLOCATION_TYPE::D3DKMDT_STANDARDALLOCATION_GDISURFACE => {
+            // DWM's GDI redirection surfaces are standard allocations too.  The
+            // previous implementation rejected this type with NOT_SUPPORTED,
+            // which leaves the GDI client area black even when the 3D path works.
+            // Describe the surface with the same CPU-visible 3D staging layout
+            // used by SHADOW/STAGING; the host has no pitch field in Allocate3d,
+            // so the row pitch must stay tight (Width * 4) for the host texture
+            // and the guest mapping to agree.
+            let surface_data = unsafe { &mut *standard_allocation.__bindgen_anon_1.pCreateGdiSurfaceData };
+
+            let w = surface_data.Width;
+            let h = surface_data.Height;
+            let gdi_type: u32 = unsafe { transmute(surface_data.Type) };
+            let gdi_flags: u32 = unsafe { transmute(surface_data.Flags) };
+            let mut format = VirglFormat::from(surface_data.Format);
+            if format.0 == VIRGL_FORMAT_NONE {
+                warn!("{}: GDISURFACE format {:?} has no virgl mapping; using B8G8R8A8", function!(), surface_data.Format);
+                format = VirglFormat(VIRGL_FORMAT_B8G8R8A8_UNORM);
+            }
+
+            bringup::record("GdiSurfaceType", gdi_type);
+            bringup::record("GdiSurfaceFlags", gdi_flags);
+            bringup::record("GdiSurfaceWidth", w);
+            bringup::record("GdiSurfaceHeight", h);
+            bringup::record("GdiSurfaceFormat", format.0);
+
+            if w == 0 || h == 0 {
+                error!("{}: GDISURFACE invalid size {}x{} type={} flags=0x{:08x}", function!(), w, h, gdi_type, gdi_flags);
+                bringup::record("GdiSurfaceReturnStatus", STATUS::INVALID_PARAMETER.to_u32());
+                return STATUS::INVALID_PARAMETER.to_u32();
+            }
+
+            let pitch = w.saturating_mul(4);
+            let size = (pitch as u64) * (h as u64);
+            surface_data.Pitch = pitch;
+            let flags = VirglFlags::MAP_COHERENT;
+
+            {
+                use core::sync::atomic::AtomicU32;
+                static GDI_CALLS: AtomicU32 = AtomicU32::new(0);
+                bringup::count("GdiSurfaceCallCount", &GDI_CALLS);
+            }
+            bringup::record("GdiSurfacePitch", pitch);
+            bringup::record("GdiSurfaceSizeLo", size as u32);
+            error!(
+                "{}: GDISURFACE type={} format=0x{:08x} flags=0x{:08x} {}x{} pitch={} size={}",
+                function!(), gdi_type, format.0, gdi_flags, w, h, pitch, size
+            );
+
+            (w, h, size, format.into(), flags.bits())
+        },
         _ => {
             error!("{}: unsupported standard allocation type {:?}", function!(), standard_allocation.StandardAllocationType);
