+
+/// Write a GDISURFACE diagnostic where the test harness can read it even when
+/// the dedicated `Parameters\Bringup` key was not created or denies
+/// KEY_SET_VALUE: try the Bringup key first, then the service Parameters key,
+/// then the display class software keys.
+#[cfg(feature = "bringup-diagnostics")]
+pub fn record_gdi(name: &str, value: u32) {
+    const PATHS: [&str; 4] = [
+        "\\Registry\\Machine\\System\\CurrentControlSet\\Services\\VirtioGpu\\Parameters\\Bringup",
+        "\\Registry\\Machine\\System\\CurrentControlSet\\Services\\VirtioGpu\\Parameters",
+        "\\Registry\\Machine\\System\\CurrentControlSet\\Control\\Class\\{4d36e968-e325-11ce-bfc1-08002be10318}\\0000",
+        "\\Registry\\Machine\\System\\CurrentControlSet\\Control\\Class\\{4d36e968-e325-11ce-bfc1-08002be10318}\\0001",
+    ];
+    for path in PATHS {
+        if write_record_at(path, name, value) {
+            break;
+        }
+    }
+}
+
+#[cfg(feature = "bringup-diagnostics")]
+fn write_record_at(path: &str, name: &str, value: u32) -> bool {
+    use core::{mem::zeroed, ptr::null_mut};
+    use wdk::wdm::*;
+    if unsafe { KeGetCurrentIrql() } != 0 { return false; }
+
+    let mut path_buf: alloc::vec::Vec<u16> = path.encode_utf16().collect();
+    let mut key_name = UNICODE_STRING {
+        Length: (path_buf.len() * 2) as u16,
+        MaximumLength: (path_buf.len() * 2) as u16,
+        Buffer: path_buf.as_mut_ptr(),
+    };
+    let mut attrs: OBJECT_ATTRIBUTES = unsafe { zeroed() };
+    attrs.Length = core::mem::size_of::<OBJECT_ATTRIBUTES>() as u32;
+    attrs.ObjectName = &mut key_name;
+    attrs.Attributes = OBJ_CASE_INSENSITIVE | OBJ_KERNEL_HANDLE;
+    let mut handle = null_mut();
+    let status = unsafe { ZwOpenKey(&mut handle, KEY_SET_VALUE, &mut attrs) };
+    if (status as i32) < 0 { return false; }
+
+    let mut name_buf: alloc::vec::Vec<u16> = name.encode_utf16().collect();
+    let mut value_name = UNICODE_STRING {
+        Length: (name_buf.len() * 2) as u16,
+        MaximumLength: (name_buf.len() * 2) as u16,
+        Buffer: name_buf.as_mut_ptr(),
+    };
+    let status = unsafe {
+        ZwSetValueKey(handle, &mut value_name, 0, REG_DWORD,
+                      (&value as *const u32).cast_mut().cast(), core::mem::size_of::<u32>() as u32)
+    };
+    unsafe { ZwClose(handle); }
+    (status as i32) >= 0
+}
+
+#[cfg(not(feature = "bringup-diagnostics"))]
+pub fn record_gdi(_name: &str, _value: u32) {}
