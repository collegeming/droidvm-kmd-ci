+    /// Hides the cursor with virtio-gpu's authoritative disable form: UPDATE_CURSOR with
+    /// resource_id 0. The guest-side Cursor object stays allocated; only the device's
+    /// cursor scanout is taken down.
+    pub fn disable_cursor(&self, scanout_id: u32, hot_x: u32, hot_y: u32, x: u32, y: u32) -> Result<(), NtStatus> {
+        let cmd = commands::UpdateCursor {
+            header: self.new_header(commands::Command::UPDATE_CURSOR, false, None, None),
+            pos: commands::CursorPos {
+                scanout_id,
+                x,
+                y,
+                _padding: 0,
+            },
+            resource_id: 0,
+            hot_x,
+            hot_y,
+            _padding: 0,
+        };
+
+        self.cursor.request_async::<_, commands::CtrlHeader>(cmd, Callback::None)?;
+
+        Ok(())
+    }
